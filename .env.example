# Medical RAG System Environment Variables
# Copy this file to .env and fill in your actual values

# REQUIRED: Groq API Key for LLM responses
# Get your free API key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL: Medical Research APIs for Glaucoma Corpus Builder
# PubMed API Key (optional, but recommended for higher rate limits)
# Get your API key at: https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/
PUBMED_API_KEY=your_pubmed_api_key_here

# ClinicalTrials.gov API Key (optional)
CLINICAL_TRIALS_API_KEY=your_clinical_trials_api_key_here

# OpenFDA API Key (optional, but recommended for higher rate limits)
# Get your API key at: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=your_openfda_api_key_here

# WHO API Key (optional)
WHO_API_KEY=your_who_api_key_here

# UMLS API Key (for medical terminology services)
# Get your API key at: https://uts.nlm.nih.gov/uts/
UMLS_API_KEY=your_umls_api_key_here

# Europe PMC API Key (optional)
EUROPEPMC_API_KEY=your_europepmc_api_key_here

# Crossref API Key (optional)
CROSSREF_API_KEY=your_crossref_api_key_here

# OPTIONAL: Logging configuration
LOG_LEVEL=INFO

# OPTIONAL: Cache settings
CACHE_ENABLED=true

# OPTIONAL: Flask configuration
FLASK_DEBUG=false
FLASK_PORT=5000
